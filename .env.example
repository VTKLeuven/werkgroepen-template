# Copy to .env and fill in real values: cp .env.example .env
#
# Do NOT quote values. Docker Compose loads this file with `format: raw`,
# which passes values through literally -- quotes would end up inside the
# password itself. A "$" is safe here; it is not interpolated.

# Password for the Postgres container and the app's connection to it.
# Use letters and digits only: this one IS interpolated into DATABASE_URL by
# docker-compose.yml, where "$" is eaten and "@ : /" break the URL.
POSTGRES_PASSWORD=change-me-generate-a-random-one

# Only used for local development outside Docker. Under Docker Compose the
# app's DATABASE_URL is built from POSTGRES_PASSWORD and points at the db
# service, overriding whatever is set here.
DATABASE_URL=postgresql://werkgroep:werkgroep@localhost:5432/werkgroep?schema=public

# Generate with: npx auth secret
AUTH_SECRET=change-me-generate-with-npx-auth-secret

# Public origin of the deployment, e.g. https://chemix.vtk.be
AUTH_URL=http://localhost:3000

# Seeded into the database on every container start, so changing
# ADMIN_PASSWORD here and restarting will reset the password.
# Changing ADMIN_EMAIL creates a NEW admin and leaves the old one in place --
# delete the old row by hand (see README).
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-before-deploy

# Only used for local development outside Docker; Compose sets /app/uploads.
UPLOAD_DIR=./uploads
