// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  nl
}

enum LanguageMode {
  bilingual
  englishOnly
  dutchOnly
}

enum LogoMode {
  iconWithText
  wordmark
}

enum HeroTextPosition {
  topLeft
  topCenter
  topRight
  centerLeft
  center
  centerRight
  bottomLeft
  bottomCenter
  bottomRight
}

enum CoverDisplayMode {
  full
  flexible
  fit
  fill
  crop
}

enum CoverBorderStyle {
  solid
  dashed
  dotted
  double
}

enum CoverFrameShadow {
  none
  soft
  strong
}

enum CoverPlacement {
  above
  left
  right
}

enum SectionKey {
  about
  team
  events
  contact
  partners
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id                     String           @id @default("site")
  defaultLocale          Locale           @default(en)
  languageMode           LanguageMode     @default(bilingual)
  siteName               String           @default("Chemix")
  siteNameEn             String           @default("Chemix")
  siteNameNl             String           @default("Chemix")
  headerName             String           @default("Chemix")
  headerNameEn           String           @default("Chemix")
  headerNameNl           String           @default("Chemix")
  logoMode               LogoMode         @default(iconWithText)
  logoMediaId            String?
  logoMedia              MediaAsset?      @relation("SiteLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  faviconMediaId         String?
  faviconMedia           MediaAsset?      @relation("SiteFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  heroMediaId            String?
  heroMedia              MediaAsset?      @relation("HeroImage", fields: [heroMediaId], references: [id], onDelete: SetNull)
  aboutMediaId           String?
  aboutMedia             MediaAsset?      @relation("AboutImage", fields: [aboutMediaId], references: [id], onDelete: SetNull)
  heroEyebrow            String           @default("VTK subdivision")
  heroEyebrowEn          String           @default("VTK subdivision")
  heroEyebrowNl          String           @default("VTK werkgroep")
  heroTitle              String           @default("A student community for curious engineers")
  heroTitleEn            String           @default("A student community for curious engineers")
  heroTitleNl            String           @default("Een studentencommunity voor nieuwsgierige ingenieurs")
  heroSlogan             String?
  heroSloganEn           String?
  heroSloganNl           String?
  heroButtonText         String?
  heroButtonTextEn       String?
  heroButtonTextNl       String?
  heroButtonUrl          String?
  heroTextPosition       HeroTextPosition @default(bottomLeft)
  aboutTitle             String           @default("About us")
  aboutTitleEn           String           @default("About us")
  aboutTitleNl           String           @default("Over ons")
  aboutText              String           @db.Text
  aboutTextEn            String           @default("") @db.Text
  aboutTextNl            String           @default("") @db.Text
  aboutCoverDisplayMode  CoverDisplayMode @default(fill)
  aboutCoverWidth        Float            @default(100)
  aboutCoverPositionX    Float            @default(50)
  aboutCoverPositionY    Float            @default(50)
  aboutCoverZoom         Float            @default(1)
  aboutCoverBorderWidth  Float            @default(0)
  aboutCoverBorderStyle  CoverBorderStyle @default(solid)
  aboutCoverBorderColor  String           @default("#231f20")
  aboutCoverBorderRadius Float            @default(32)
  aboutCoverFrameShadow  CoverFrameShadow @default(strong)
  aboutCoverColumnWidth  Float            @default(42)
  contactTitle           String           @default("Contact us")
  contactTitleEn         String           @default("Contact us")
  contactTitleNl         String           @default("Contacteer ons")
  contactText            String?          @db.Text
  contactTextEn          String?          @db.Text
  contactTextNl          String?          @db.Text
  contactEmail           String           @default("hello@example.org")
  facebookUrl            String?
  instagramUrl           String?
  linkedinUrl            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model ThemeSettings {
  id                 String   @id @default("theme")
  backgroundColor    String   @default("#f7f3ec")
  surfaceColor       String   @default("#fffaf2")
  textColor          String   @default("#231f20")
  mutedColor         String   @default("#6f6860")
  primaryColor       String   @default("#006d77")
  accentColor        String   @default("#f4a261")
  headerColor        String   @default("#fffaf2")
  bodyFontScale      Float    @default(1)
  headingFontScale   Float    @default(1)
  heroTitleFontScale Float    @default(1)
  heroBodyFontScale  Float    @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MediaAsset {
  id                  String         @id @default(cuid())
  fileName            String         @unique
  originalName        String
  mimeType            String
  size                Int
  alt                 String?
  createdAt           DateTime       @default(now())
  siteLogos           SiteSettings[] @relation("SiteLogo")
  siteFavicons        SiteSettings[] @relation("SiteFavicon")
  heroImages          SiteSettings[] @relation("HeroImage")
  aboutImages         SiteSettings[] @relation("AboutImage")
  teamMemberPortraits TeamMember[]   @relation("TeamMemberPortrait")
  eventPictures       Event[]        @relation("EventPicture")
  partnerLogos        Partner[]      @relation("PartnerLogo")
  customPageCovers    CustomPage[]   @relation("CustomPageCover")
}

model SiteSection {
  key              SectionKey @id
  sortOrder        Int
  isVisible        Boolean    @default(true)
  showInNavigation Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model TeamMember {
  id             String           @id @default(cuid())
  name           String
  functionName   String
  functionNameEn String           @default("")
  functionNameNl String           @default("")
  url            String?
  imageMediaId   String?
  imageMedia     MediaAsset?      @relation("TeamMemberPortrait", fields: [imageMediaId], references: [id], onDelete: SetNull)
  sortOrder      Int              @default(0)
  isVisible      Boolean          @default(true)
  academicYears  TeamMemberYear[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model AcademicYear {
  id          String           @id @default(cuid())
  label       String           @unique
  sortOrder   Int              @default(0)
  isCurrent   Boolean          @default(false)
  teamMembers TeamMemberYear[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TeamMemberYear {
  teamMemberId   String
  academicYearId String
  sortOrder      Int          @default(0)
  teamMember     TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@id([teamMemberId, academicYearId])
  @@index([academicYearId, sortOrder])
}

model Event {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  titleEn        String      @default("")
  titleNl        String      @default("")
  summary        String?
  summaryEn      String?
  summaryNl      String?
  description    String      @db.Text
  descriptionEn  String      @default("") @db.Text
  descriptionNl  String      @default("") @db.Text
  location       String
  locationEn     String      @default("")
  locationNl     String      @default("")
  startAt        DateTime
  endAt          DateTime?
  pictureMediaId String?
  pictureMedia   MediaAsset? @relation("EventPicture", fields: [pictureMediaId], references: [id], onDelete: SetNull)
  isPublished    Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Partner {
  id          String      @id @default(cuid())
  name        String
  nameEn      String      @default("")
  nameNl      String      @default("")
  websiteUrl  String
  logoMediaId String?
  logoMedia   MediaAsset? @relation("PartnerLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  sortOrder   Int         @default(0)
  isVisible   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CustomPage {
  id                String           @id @default(cuid())
  slug              String           @unique
  titleEn           String           @default("")
  titleNl           String           @default("")
  eyebrowEn         String?
  eyebrowNl         String?
  supportingTextEn  String?          @db.Text
  supportingTextNl  String?          @db.Text
  contentEn         String           @default("") @db.Text
  contentNl         String           @default("") @db.Text
  coverMediaId      String?
  coverMedia        MediaAsset?      @relation("CustomPageCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  coverDisplayMode  CoverDisplayMode @default(fill)
  coverWidth        Float            @default(75)
  coverPositionX    Float            @default(50)
  coverPositionY    Float            @default(50)
  coverZoom         Float            @default(1)
  coverBorderWidth  Float            @default(0)
  coverBorderStyle  CoverBorderStyle @default(solid)
  coverBorderColor  String           @default("#231f20")
  coverBorderRadius Float            @default(32)
  coverFrameShadow  CoverFrameShadow @default(strong)
  coverPlacement    CoverPlacement   @default(above)
  coverSideWidth    Float            @default(42)
  sortOrder         Int              @default(0)
  isPublished       Boolean          @default(false)
  showInNavigation  Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([isPublished, showInNavigation, sortOrder])
}
